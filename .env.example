APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FILESYSTEM_PUBLIC_URL=/storage

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

XOFTWARE_API_KEY=
XOFTWARE_SECRET_KEY=
XOFTWARE_WEBHOOK_SECRET=
XOFTWARE_MERCHANT_ID=
XOFTWARE_BASE_URL=https://payment1.xoftware.id
XOFTWARE_DEFAULT_CHANNEL=QRISREALTIME
XOFTWARE_FEE_DIRECTION=merchant
XOFTWARE_EXPIRED_MINUTES=60
XOFTWARE_BUYER_FEE_SHARE=0.7
XOFTWARE_QRIS_FEE_PERCENT=0.007
XOFTWARE_QRIS_FEE_FIXED=150
XOFTWARE_QRIS_REALTIME_FEE_PERCENT=0.007
XOFTWARE_QRIS_REALTIME_FEE_FIXED=250

DIGIFLAZZ_USERNAME=
DIGIFLAZZ_KEY=
DIGIFLAZZ_BASE_URL=

ORDERSOSMED_API_URL=
ORDERSOSMED_API_ID=
ORDERSOSMED_API_KEY=
ORDERSOSMED_SECRET_KEY=

DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_TRANSACTIONS_URL=
DISCORD_WEBHOOK_MANUAL_TRANSACTIONS_URL=
DISCORD_WEBHOOK_MANUAL_TRANSACTION_URL=
DISCORD_WEBHOOK_DEPOSITS_URL=
DISCORD_WEBHOOK_DEPOSIT_URL=
DISCORD_WEBHOOK_WITHDRAWALS_URL=
DISCORD_WEBHOOK_WITHDRAWAL_URL=
DISCORD_WEBHOOK_PENARIKAN_URL=
DISCORD_WEBHOOK_REFUNDS_URL=
DISCORD_WEBHOOK_REPORTS_URL=
DISCORD_WEBHOOK_STOCK_URL=
DISCORD_WEBHOOK_SYSTEM_URL=
DISCORD_WEBHOOK_SYSTEMS_URL=
DISCORD_WEBHOOK_ERRORS_URL=
DISCORD_BOT_NAME="Wiboost Bot"
DISCORD_BOT_AVATAR_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

WIBOOST_PUBLIC_URL=
# Production: isi sama dengan domain final, contoh https://wibooststore.com.

WIBOOST_ADMIN_LABEL="Admin Wiboost"
WIBOOST_ADMIN_WHATSAPP=
WIBOOST_ADMIN_REPORT_INTRO="Halo Admin Wiboost, saya ingin melaporkan kendala di website."

WIBOOST_PENDING_ALERT_MINUTES=60
WIBOOST_PROCESSING_ALERT_MINUTES=120
WIBOOST_MAINTENANCE_MAX_ITEMS=5

# Jalankan di server production:
# * * * * * php /path/to/WiboostStore/artisan schedule:run >> /dev/null 2>&1
# Jika QUEUE_CONNECTION=database/redis, jalankan juga php artisan queue:work.

VITE_APP_NAME="${APP_NAME}"
